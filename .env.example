# Server Configuration
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=dpms_licenses
DB_CONNECTION_LIMIT=10

# Cryptography & Security Secrets
ENCRYPTION_SECRET=your_32_byte_hex_encryption_key_here
HMAC_SIGNATURE_KEY=your_hmac_signature_key_here

# Admin Controller Security
ADMIN_API_KEY=DPMS-ADMIN-SECRET-KEY-9988

# License Key Formatting Prefix
LICENSE_PREFIX=DPMS
